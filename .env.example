# --- Pflicht: Claude API (https://platform.claude.com) ---
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5

# --- E-Mail an die Eltern (ohne SMTP werden Mails nur in data/outbox/ abgelegt) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Weihnachtsmann <weihnachtsmann@deine-domain.de>"

# --- Amazon ---
AMAZON_DOMAIN=amazon.de
# Optional: Amazon-Partner-ID (PartnerNet), wird an die Links angehängt
AMAZON_PARTNER_TAG=

# --- Optional: sehr natürliche Weihnachtsmann-Stimme über ElevenLabs ---
# Ohne diese Werte nutzt der Browser seine eingebaute (robotischere) Stimme.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

PORT=3000
